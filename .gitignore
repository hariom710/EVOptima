# ----- ML artifacts -----
# Deliberately committed, NOT ignored: a fresh clone must be able to serve
# /prediction/ straight after `migrate`, with no training run first. What is
# shipped is everything `current.json` points at -- power-v1/, the legacy root
# alias (model.joblib/scaler.joblib), meta.json and the leakage audit.
# There is one model only; see ml/pipeline/__init__.py for why a second one
# cannot be learned from these CSVs.
#
# Version directories from a *future* retrain are ignored so that re-running
# `python scripts/train_models.py` does not silently add ~3.5 MB per retrain.
# When you promote a new version, move the `!` rule down to it (and
# commit the updated current.json).
ml/artifacts/*-v[0-9]*/
!ml/artifacts/power-v1/
# A model dumped at the repo root by mistake.
/*.joblib

# ----- Data -----
# The two training CSVs are committed (1.2 MB) so `python scripts/train_models.py`
# works on a fresh clone -- the pipeline reads exactly DATASET_FILES from
# ml/pipeline/data.py. Everything else under data/raw stays local.
data/raw/*
!data/raw/ev_charging_data1.csv
!data/raw/ev_charging_data2.csv
ev_data.csv.csv

# ----- Notebooks -----
.ipynb_checkpoints/

# TEMP (Phase 0): duplicate wrapper tree is byte-identical and is deleted in
# Phase 1; ignore its one remaining untracked file so status stays clean.
# Remove this rule together with the EVOptima/EVOptima/ folder in Phase 1.
EVOptima/EVOptima/

