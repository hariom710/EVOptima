# EVOptima environment template
#
#   1. copy .env.example  ->  .env
#   2. fill in the values below
#
# config/settings/base.py loads the repo-root .env via python-dotenv. Real
# process environment variables always take precedence over .env, so in Docker
# or CI you can simply export these instead of shipping a file. .env itself is
# gitignored -- never commit it.
#
# Every variable below is read by config/settings/{base,dev,prod}.py.

# ----------------------------------------------------------------- required
# Used by ALL settings modules (base.py falls back to this in dev only; prod
# refuses to start without it). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Must be >= 50 characters to satisfy the W009 security check.
DJANGO_SECRET_KEY=change-me-to-a-random-50-plus-character-string

# ------------------------------------------------------------------ debug
# "1" / "true" / "yes" / "on" enable DEBUG. MUST be 0 in production (W018).
DJANGO_DEBUG=0

# ------------------------------------------------------------------- hosts
# Comma-separated hostnames the app may serve. Required when DEBUG=0.
#   e.g. DJANGO_ALLOWED_HOSTS=evoptima.example.com,api.evoptima.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated FULL origins for CSRF (scheme + host [+ port]).
# Required whenever the site is served over https.
#   e.g. DJANGO_CSRF_TRUSTED_ORIGINS=https://evoptima.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------- database
# Required by config.settings.prod (SQLite is dev-only).
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://evoptima:change-me@localhost:5432/evoptima

# ------------------------------------------------------------------- redis
# Channel layer used by prod.py for WebSocket fan-out. dev.py uses the
# in-process InMemoryChannelLayer and ignores this.
REDIS_URL=redis://127.0.0.1:6379/0

# --------------------------------------------------------------- transport
# "1" (default) redirects every http:// request to https://. Set to 0 when
# running behind a local plain-http proxy, or while bootstrapping.
DJANGO_SECURE_SSL_REDIRECT=1

# HSTS max-age in seconds (default 31536000 = 1 year).
DJANGO_HSTS_SECONDS=31536000

# ------------------------------------------------------------------- email
# dev.py forces the console backend; these are read by prod.py only.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=noreply@evoptima.example.com

# ------------------------------------------------------------------ logging
# Threshold for the `apps` and root loggers (base.py). prod.py additionally
# emits JSON lines to stdout at this level.
DJANGO_LOG_LEVEL=INFO

# --------------------------------------------------------------- operations
# Path to the trained artifacts (base.py default: <repo>/ml/artifacts).
# MODEL_DIR=
# Path to the replay datasets (base.py default: <repo>/data/raw).
# DATA_DIR=
